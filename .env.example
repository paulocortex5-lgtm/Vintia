# ─── Vantia configuration (copy to .env) ──────────────────────────────
# NEVER commit a real .env. Values below are placeholders.

# ─── Core engine ──────────────────────────────────────────────────────
VANTIA_MASTER_VERSION=4.0
VANTIA_STATE_DIR=.vantia/state
VANTIA_LOG_LEVEL=INFO
VANTIA_MAX_COST_USD=0.00          # free-tier only: hard cap on paid spend
VANTIA_ALLOW_PAID_LLM=0           # 1 to enable paid provider chains

# ─── LLM router (free providers; keys optional, router skips missing) ──
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
GITHUB_MODELS_TOKEN=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=

# ─── LLM router (paid providers; disabled unless VANTIA_ALLOW_PAID_LLM=1) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# ─── Persistence (Supabase) ───────────────────────────────────────────
SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_JWT_SECRET=REPLACE_ME

# ─── Workspaces ───────────────────────────────────────────────────────
VANTIA_WORKSPACE_ENABLED=true
VANTIA_STORAGE_BUCKET=user-workspaces
VANTIA_MAX_FILE_SIZE_MB=10
VANTIA_ALLOWED_FILE_TYPES=pdf,docx,doc,txt,md

# ─── Credits ──────────────────────────────────────────────────────────
VANTIA_CREDITS_ENABLED=true
VANTIA_FREE_TIER_TOKENS=10000
VANTIA_PRO_TIER_TOKENS=100000
VANTIA_BUSINESS_TIER_TOKENS=1000000
# Browser origins allowed to call the engine (Vercel → Render); comma-separated
VANTIA_ALLOWED_ORIGINS=http://localhost:3000

# ─── Paddle (payments) ────────────────────────────────────────────────
PADDLE_API_KEY=REPLACE_ME
PADDLE_CLIENT_TOKEN=REPLACE_ME
PADDLE_WEBHOOK_SECRET=REPLACE_ME
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_PACK_10K=REPLACE_ME
PADDLE_PRICE_PACK_50K=REPLACE_ME
PADDLE_PRICE_PACK_250K=REPLACE_ME
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=REPLACE_ME
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Engine base URL the browser calls (Render URL in deployment)
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# ─── Source fetching (Phase 2: jobs/scholarships crawl base) ──────────
VANTIA_FETCH_TIMEOUT_SEC=20
VANTIA_FETCH_MIN_INTERVAL_SEC=1.0    # polite delay between hits per domain
VANTIA_FETCH_MAX_PER_DAY=500         # per-domain daily budget
VANTIA_FETCH_MAX_BYTES=2000000       # refuse bodies larger than this
VANTIA_FETCH_RETRIES=3               # 5xx/timeout retries with backoff
VANTIA_FETCH_USER_AGENT=Vantia/0.6 (+https://vantia.ai/bot)
VANTIA_AA_API_KEY=jobboerse-jobsuche # German Federal Employment Agency jobs API

# ─── Deployment ───────────────────────────────────────────────────────
VANTIA_BACKEND_URL=https://vantia-engine.onrender.com
VANTIA_HEALTH_ENDPOINT=/health
VANTIA_SELF_PING_INTERVAL_SEC=600
VANTIA_VERCEL_TIER=free
VANTIA_VERCEL_MAX_BODY_MB=4.5

# ─── GitHub (for issue creation / pushes from CI) ─────────────────────
GITHUB_TOKEN=
GITHUB_REPOSITORY=paulocortex5-lgtm/Vintia
