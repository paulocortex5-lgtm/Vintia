{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantia.ai/schemas/cv_improvement.schema.json",
  "title": "CV Improvement",
  "type": "object",
  "required": ["original_cv_id", "improvements", "improved_cv", "summary"],
  "properties": {
    "original_cv_id": {"type": "string"},
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "original_text", "improved_text", "reason"],
        "properties": {
          "category": {"type": "string", "enum": ["formatting", "content", "keyword_optimization", "grammar", "clarity", "action_verbs", "metrics", "structure"]},
          "section": {"type": "string", "description": "Which section of the CV (e.g. 'Professional Experience')"},
          "original_text": {"type": "string"},
          "improved_text": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string", "enum": ["high", "medium", "low"]},
          "priority": {"type": "integer", "minimum": 1, "maximum": 10}
        }
      }
    },
    "improved_cv": {"type": "string", "description": "Full improved CV as plain text"},
    "summary": {"type": "object", "required": ["total_improvements", "high_impact_count", "medium_impact_count", "low_impact_count"], "properties": {"total_improvements": {"type": "integer", "minimum": 0}, "high_impact_count": {"type": "integer", "minimum": 0}, "medium_impact_count": {"type": "integer", "minimum": 0}, "low_impact_count": {"type": "integer", "minimum": 0}, "top_categories": {"type": "array", "items": {"type": "string"}}}}
  }
}
