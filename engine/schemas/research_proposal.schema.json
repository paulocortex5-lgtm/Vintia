{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantia.ai/schemas/research_proposal.schema.json",
  "title": "Research Proposal",
  "type": "object",
  "description": "Generated research proposal for a graduate program (task 1.3).",
  "required": ["applicant_id", "title", "research_question", "abstract", "content", "keywords", "sections", "metadata"],
  "properties": {
    "applicant_id": {
      "type": "string",
      "description": "Vantia applicant profile id the proposal was written for."
    },
    "program_id": {
      "type": "string",
      "description": "Target graduate program id."
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "description": "Proposed research title."
    },
    "research_question": {
      "type": "string",
      "minLength": 20,
      "description": "The single question the project is built around."
    },
    "abstract": {
      "type": "string",
      "minLength": 50,
      "description": "150-250 word abstract."
    },
    "content": {
      "type": "string",
      "description": "Full proposal as plain text",
      "minLength": 400
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {"type": "string"},
      "description": "Index terms a reviewer or search engine would use."
    },
    "methodology": {
      "type": "string",
      "description": "How the research question will be answered."
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "duration_months"],
        "properties": {
          "phase": {"type": "string"},
          "duration_months": {"type": "integer", "minimum": 1, "maximum": 48},
          "milestones": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": {
            "type": "string",
            "description": "Section name: Background, Motivation, Methodology, Timeline, Impact"
          },
          "body": {"type": "string"},
          "word_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["total_word_count", "generated_at"],
      "properties": {
        "total_word_count": {"type": "integer", "minimum": 0},
        "generated_at": {"type": "string", "format": "date-time"},
        "model": {"type": "string"},
        "degree_level": {"type": "string", "enum": ["MRes", "MSc", "PhD", "Master", "Doctoral"]},
        "target_program": {"type": "string"},
        "funding_body": {"type": "string"},
        "language": {"type": "string"}
      }
    }
  }
}
