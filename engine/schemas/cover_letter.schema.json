{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantia.ai/schemas/cover_letter.schema.json",
  "title": "Cover Letter",
  "type": "object",
  "required": ["resume_id", "job_id", "content", "sections", "metadata"],
  "properties": {
    "resume_id": {"type": "string"},
    "job_id": {"type": "string"},
    "content": {"type": "string", "description": "Full cover letter as plain text", "minLength": 100},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": {"type": "string"},
          "body": {"type": "string"},
          "word_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["company_name", "job_title", "total_word_count", "generated_at"],
      "properties": {
        "company_name": {"type": "string"},
        "job_title": {"type": "string"},
        "total_word_count": {"type": "integer", "minimum": 0},
        "generated_at": {"type": "string", "format": "date-time"},
        "model": {"type": "string"},
        "tone": {"type": "string", "enum": ["formal", "professional", "casual", "confident"]},
        "personalization_keywords_used": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
